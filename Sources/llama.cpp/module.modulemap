module llama [system] {
    header "llama.h"
    header "ggml.h"
    header "ggml-alloc.h"
    header "ggml-backend.h"

    link "llama"
    // Swift calls ggml backend discovery/device APIs directly. Shared
    // llama.cpp builds do not re-export those import-library symbols.
    link "ggml"
    link "ggml-base"

    export *
}
